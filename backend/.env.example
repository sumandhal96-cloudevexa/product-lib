# Copy to .env for local (non-Docker) development. Never commit .env.
PORT=3000

# Product data source (swap the adapter in src/server.ts to change source)
FAKE_STORE_BASE_URL=https://fakestoreapi.com
CACHE_TTL_SECONDS=300

# Home page "top rated" products: comma-separated product ids (curated by the business)
FEATURED_PRODUCT_IDS=3,5,7,11,12
# How many top-rated products to show before "additional" ones on a category page
CATEGORY_TOP_RATED_COUNT=3

# Email (default points at Mailpit from docker compose; UI at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM=catalogue@example.com
SALES_INBOX_EMAIL=sales@example.com

# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Number of reverse proxies in front of the API (0 when none, 1 behind nginx)
TRUST_PROXY=0
